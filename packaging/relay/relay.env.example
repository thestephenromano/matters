# Copy to relay.env next to compose.yaml and edit. Keep relay.env and
# postgres_password out of version control and readable only by the operator.

# The public name Caddy obtains a certificate for, and the ACME contact
# address (or "internal" for Caddy's private CA).
MATTERS_RELAY_DOMAIN=relay.example.org
MATTERS_RELAY_TLS=operator@example.org

# The relay's database. The password must match the postgres_password file.
MATTERS_RELAY_DATABASE_URL=postgres://relay:CHANGE-ME@postgres:5432/relay

# Optional: per route and device, <per-second>/<burst>, for authenticated
# requests (off by default).
# MATTERS_RELAY_RATE=20/100
# Optional: requests without a session, per route, and session challenges
# per route and device (defaults shown; "off" turns one off).
# MATTERS_RELAY_PUBLIC_RATE=10/60
# MATTERS_RELAY_CHALLENGE_RATE=1/10

# Optional: the export credential, 64 hex digits (openssl rand -hex 32).
# MATTERS_RELAY_OPERATOR_TOKEN=

# Optional: server limits (defaults shown): seconds to send headers, seconds
# to answer a request, and requests handled at once.
# MATTERS_RELAY_HEADER_TIMEOUT=10
# MATTERS_RELAY_REQUEST_TIMEOUT=60
# MATTERS_RELAY_MAX_REQUESTS=256
