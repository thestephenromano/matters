# TLS in front of the relay (#44). Caddy obtains and renews the certificate
# for MATTERS_RELAY_DOMAIN from a public CA, with MATTERS_RELAY_TLS as
# the ACME contact address. "internal" uses Caddy's own private CA instead,
# for a host without a public name, as the CI smoke test does.
{$MATTERS_RELAY_DOMAIN} {
	tls {$MATTERS_RELAY_TLS}
	# Only the v0 API and health are public. Metrics stay on the private network.
	# Export is operator-only: on the relay's private listener or with
	# `matters-relay export`, never through the public name.
	@export path /v0/routes/*/export /v0/routes/*/export/*
	handle @export {
		respond 404
	}
	@api path /v0/* /healthz /readyz
	handle @api {
		reverse_proxy relay:8484
	}
	handle {
		respond 404
	}
}
