# Copy to caddy.env next to compose.yaml and edit. Caddy gets only this
# file: no database credential or operator token.

# The public name Caddy obtains a certificate for, and the ACME contact
# address (or "internal" for Caddy's private CA).
MATTERS_RELAY_DOMAIN=relay.example.org
MATTERS_RELAY_TLS=operator@example.org
